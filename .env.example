# =============================================================================
# JioMart Deal Notifier - Configuration
# =============================================================================
# Copy this file to .env and fill in your details.
#
# 1. TELEGRAM_BOT_TOKEN: Create a bot with @BotFather on Telegram to get your token.
# 2. TELEGRAM_CHAT_ID: Message @userinfobot or @raw_data_bot on Telegram to get your Chat ID.
#    (For a public channel, use @your_channel_username)
# 3. JIOMART_PINCODE: Your 6-digit delivery pincode (e.g. 560045).
# =============================================================================

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
JIOMART_PINCODE=560045

# Optional Settings
MIN_DISCOUNT=60
DEAL_LIMIT=20
DEPARTMENT=groceries
